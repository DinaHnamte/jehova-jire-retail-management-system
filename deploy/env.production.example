# /etc/jj-retail/env  (owner root, mode 0600; read by systemd). Never commit the real file.
# systemd EnvironmentFile syntax: KEY=value, no shell expansion. Percent-encode the URL password.
APP_ENV=production
APP_BIND=127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgres://jj_retail:CHANGE_ME@localhost:5432/jj_retail
DATABASE_MAX_CONNECTIONS=10
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_FORMAT=json
RUN_MIGRATIONS=false
STORAGE_PATH=/var/lib/jj-retail/files

# /etc/caddy/Caddyfile — set JJ_DOMAIN in Caddy's environment (systemctl edit caddy).
#
# The site sits behind Cloudflare's proxy. Requests are only trusted to carry a real client
# IP (CF-Connecting-IP) when they come from Cloudflare's ranges
# (https://www.cloudflare.com/ips/, checked 2026-11-05; refresh if Cloudflare adds ranges).
# The API receives exactly one X-Forwarded-For value: that resolved client IP.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

{$JJ_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /health/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Hashed build assets: cached forever, and a missing file is a real 404 (never index.html),
	# so a tab from an older release fails cleanly and the app reloads into the new one.
	handle /assets/* {
		root * /srv/jj-retail/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, sw.js, manifest, deep links): always revalidate.
	handle {
		root * /srv/jj-retail/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

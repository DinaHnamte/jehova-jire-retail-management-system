# /etc/caddy/Caddyfile — set JJ_DOMAIN in Caddy's environment (e.g. systemctl edit caddy).
{$JJ_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /health/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Hashed build assets: cached forever, and a missing file is a real 404 (never index.html),
	# so a tab from an older release fails cleanly and the app reloads into the new one.
	handle /assets/* {
		root * /srv/jj-retail/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, sw.js, manifest, deep links): always revalidate.
	handle {
		root * /srv/jj-retail/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

  "db_name": "PostgreSQL",
  "query": "SELECT rl.return_id, rl.order_line_id, ol.product_name, rl.quantity, rl.disposition,\n                  rl.amount\n           FROM return_lines rl\n           JOIN order_lines ol ON ol.id = rl.order_line_id\n           JOIN returns r ON r.id = rl.return_id\n           WHERE r.order_id = $1\n           ORDER BY ol.line_no, rl.id",

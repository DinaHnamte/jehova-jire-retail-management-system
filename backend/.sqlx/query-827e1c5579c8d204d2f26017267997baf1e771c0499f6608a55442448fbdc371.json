  "query": "SELECT ol.id, ol.product_id, ol.quantity, ol.net_amount,\n                  COALESCE((SELECT SUM(rl.quantity) FROM return_lines rl\n                            WHERE rl.order_line_id = ol.id), 0)::BIGINT AS \"returned!\"\n           FROM order_lines ol\n           WHERE ol.order_id = $1 AND ol.id = ANY($2)",

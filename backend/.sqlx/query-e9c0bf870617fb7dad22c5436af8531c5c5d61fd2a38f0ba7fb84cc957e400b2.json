  "query": "SELECT s.id AS session_id, s.csrf_token, u.id AS user_id, u.username, u.display_name\n         FROM sessions s JOIN users u ON u.id = s.user_id\n         WHERE s.token_hash = $1 AND s.expires_at > now() AND u.is_active",
